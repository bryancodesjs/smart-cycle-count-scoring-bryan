# Copy to .env and fill in from Supabase → Project Settings → Database → Connection string

# IMPORTANT (Windows / most home networks):
# The "Direct connection" host (db.<ref>.supabase.co:5432) is often IPv6-only and will
# fail with P1001. Use the Connection pooler instead.

# Migrations + seed + NestJS (Session mode, port 5432 — supports Prisma Migrate)
# Dashboard: Connect → ORMs → Prisma, or Database → Connection string → "Session pooler"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional later for app runtime under high concurrency (Transaction mode):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

PORT=3001
