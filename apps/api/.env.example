# Supabase Postgres connection string (Project Settings → Database)
# Prefer the "Transaction" pooler URI for the app; use direct URI for migrations if needed.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (migrations / seed) — replace with your Supabase direct host if pooler fails for DDL
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

PORT=3001
